    <string name="automation_perm_accessibility">Theo dõi ứng dụng</string>
    <string name="automation_perm_accessibility_desc">Dùng dịch vụ trợ năng để biết khi một ứng dụng được mở hoặc đóng. Dịch vụ không đọc nội dung màn hình.</string>
    <string name="automation_perm_notifications">Truy cập thông báo</string>
    <string name="automation_perm_notifications_desc">Cần để quy tắc nhận được thông báo mới. Nội dung chỉ dùng để so từ khoá, không lưu lại.</string>
    <string name="automation_perm_location">Vị trí</string>
    <string name="automation_perm_location_desc">Cần cho quy tắc theo vùng và để đọc tên Wi-Fi (SSID).</string>
    <string name="automation_perm_overlay">Hiển thị trên ứng dụng khác</string>
    <string name="automation_perm_overlay_desc">Cần để mở ứng dụng từ nền khi quy tắc chạy lúc bạn đang dùng app khác.</string>
    <string name="automation_perm_post_notifications">Gửi thông báo</string>
    <string name="automation_perm_post_notifications_desc">Cần cho hành động “Gửi thông báo”.</string>
    <string name="automation_perm_bluetooth">Bluetooth</string>
    <string name="automation_perm_bluetooth_desc">Cần để nhận sự kiện kết nối và đọc tên thiết bị đã ghép.</string>
    <string name="automation_perm_exact_alarm">Báo thức chính xác</string>
    <string name="automation_perm_exact_alarm_desc">Cần để quy tắc theo giờ chạy đúng phút; nếu không, MagicOS có thể trễ vài phút.</string>
    <string name="automation_perm_dnd">Chế độ không làm phiền</string>
